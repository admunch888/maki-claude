#!/usr/bin/env python3
"""maki dynamic provider for a Claude subscription (Pro or Max) over OAuth.

maki calls `info`, `resolve`, `reload`, `refresh`, `login` and `logout`; the
maki-claude plugin calls `status` for the /claude command. The subscription
token is accepted only when the system prompt opens with the Claude Code
identity line as its own block, which `info` declares as maki's system prefix.
"""

import base64
import hashlib
import http.server
import json
import os
import secrets
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

SLUG = "claude"
DISPLAY_NAME = "Claude subscription"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
AUTHORIZE_URL = "https://claude.ai/oauth/authorize"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
SCOPES = "org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload"
CALLBACK_HOST = "127.0.0.1"
CALLBACK_PORT = 53692
CALLBACK_PATH = "/callback"
REDIRECT_URI = "http://localhost:%d%s" % (CALLBACK_PORT, CALLBACK_PATH)
USER_AGENT = "claude-cli/2.1.251 (external, cli)"
IDENTITY = "You are Claude Code, Anthropic's official CLI for Claude."
REFRESH_MARGIN_S = 300
HTTP_TIMEOUT_S = 30
STDIN_POLL_S = 0.25
TOKEN_FILE_MODE = 0o600
PRIVATE_DIR_MODE = 0o700
NOT_LOGGED_IN = "not logged in to Claude: run `maki auth login claude`"


class Fail(Exception):
    """An error the user reads on stderr; the exit code tells maki it failed."""


def state_dir():
    home = os.path.expanduser("~")
    legacy = os.path.join(home, ".maki")
    if os.path.isdir(legacy):
        return legacy
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(home, ".local", "state")
    candidate = os.path.join(base, "maki")
    if os.path.isdir(candidate):
        return candidate
    return os.path.join(home, ".config", "maki")


def token_path():
    return os.path.join(state_dir(), "auth", SLUG + ".json")


def now_ms():
    return int(time.time() * 1000)


def load_tokens():
    try:
        with open(token_path(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    if not all(isinstance(data.get(key), str) for key in ("access", "refresh")):
        return None
    if not isinstance(data.get("expires"), int):
        return None
    return data


def save_tokens(tokens):
    path = token_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.name == "nt":
        # File permissions are best-effort on Windows; restrict the token file
        # to the current user when the ACL helper is available.
        try:
            import subprocess

            user = os.environ.get("USERNAME") or os.environ.get("USER") or ""
            if user:
                subprocess.run(
                    ["icacls", path, "/setowner", user, "/inheritance:r", "/grant:r", user + ":R"],
                    capture_output=True,
                    check=False,
                )
        except OSError:
            pass
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(tokens, handle, indent=2)
        return
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, TOKEN_FILE_MODE)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(tokens, handle, indent=2)
    os.replace(tmp, path)


def require_tokens():
    tokens = load_tokens()
    if tokens is None:
        raise Fail(NOT_LOGGED_IN)
    return tokens


def expires_within(tokens, seconds):
    return tokens["expires"] <= now_ms() + seconds * 1000


def post_json(url, body):
    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={"content-type": "application/json", "accept": "application/json", "user-agent": USER_AGENT},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_S) as response:
            text = response.read().decode("utf-8")
    except urllib.error.HTTPError as err:
        raise Fail("%s answered %d: %s" % (url, err.code, err.read().decode("utf-8", "replace").strip()))
    except OSError as err:
        raise Fail("%s unreachable: %s" % (url, err))
    try:
        return json.loads(text)
    except ValueError:
        raise Fail("%s returned invalid JSON" % url)


def tokens_from_response(data, previous=None):
    access = data.get("access_token")
    refresh = data.get("refresh_token") or (previous or {}).get("refresh")
    expires_in = data.get("expires_in")
    if not isinstance(access, str) or not isinstance(refresh, str) or not isinstance(expires_in, (int, float)):
        raise Fail("token response is missing access_token, refresh_token or expires_in")
    tokens = {"access": access, "refresh": refresh, "expires": now_ms() + int(expires_in) * 1000}
    account = data.get("account")
    email = account.get("email_address") if isinstance(account, dict) else None
    if not isinstance(email, str) and previous:
        email = previous.get("email")
    if isinstance(email, str):
        tokens["email"] = email
    return tokens


def refresh_tokens(tokens):
    data = post_json(
        TOKEN_URL,
        {"grant_type": "refresh_token", "client_id": CLIENT_ID, "refresh_token": tokens["refresh"]},
    )
    fresh = tokens_from_response(data, tokens)
    save_tokens(fresh)
    return fresh


def emit_auth(tokens):
    sys.stdout.write(json.dumps({"headers": {"authorization": "Bearer " + tokens["access"]}}) + "\n")


# Login


def base64url(raw):
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def parse_authorization_input(text):
    """Accepts a redirect URL, `code#state`, a query string, or a bare code."""
    value = text.strip()
    if not value:
        return None, None
    parts = urllib.parse.urlsplit(value)
    if parts.scheme and parts.netloc:
        query = urllib.parse.parse_qs(parts.query)
        return (query.get("code") or [None])[0], (query.get("state") or [None])[0]
    if "#" in value:
        code, state = value.split("#", 1)
        return code, state
    if "code=" in value:
        query = urllib.parse.parse_qs(value)
        return (query.get("code") or [None])[0], (query.get("state") or [None])[0]
    return value, None


class CallbackServer(http.server.HTTPServer):
    def __init__(self, expected_state):
        super().__init__((CALLBACK_HOST, CALLBACK_PORT), CallbackHandler)
        self.expected_state = expected_state
        self.result = None
        self.failure = None


class CallbackHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def reply(self, status, text):
        body = ("<html><body><p>%s</p></body></html>" % text).encode("utf-8")
        self.send_response(status)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parts = urllib.parse.urlsplit(self.path)
        if parts.path != CALLBACK_PATH:
            self.reply(404, "Not found.")
            return
        query = urllib.parse.parse_qs(parts.query)
        error = (query.get("error") or [None])[0]
        code = (query.get("code") or [None])[0]
        state = (query.get("state") or [None])[0]
        if error:
            self.server.failure = "login did not complete: %s" % error
            self.reply(400, "Login failed: %s" % error)
        elif not code or state != self.server.expected_state:
            self.server.failure = "callback is missing the code or carries the wrong state"
            self.reply(400, "Missing code or state mismatch.")
        else:
            self.server.result = (code, state)
            self.reply(200, "Login complete. You can close this window and return to the terminal.")


def stdin_ready(timeout_s):
    """True when a line is available on stdin within the timeout."""
    if os.name == "nt":
        import msvcrt

        deadline = time.time() + timeout_s
        while time.time() < deadline:
            if msvcrt.kbhit():
                return True
            time.sleep(0.05)
        return False
    import select

    ready, _, _ = select.select([sys.stdin], [], [], timeout_s)
    return bool(ready)


def wait_for_code(server, expected_state):
    """Returns the code from whichever arrives first: the browser callback or a
    pasted redirect URL on stdin. A closed stdin leaves only the callback."""
    sys.stdout.write("> ")
    sys.stdout.flush()
    stdin_open = True
    while True:
        if server.failure:
            raise Fail(server.failure)
        if server.result:
            return server.result
        if not stdin_open:
            time.sleep(STDIN_POLL_S)
            continue
        if not stdin_ready(STDIN_POLL_S):
            continue
        line = sys.stdin.readline()
        if not line:
            stdin_open = False
            continue
        code, state = parse_authorization_input(line)
        if code:
            if state is not None and state != expected_state:
                raise Fail("OAuth state mismatch, start the login again")
            return code, state or expected_state
        sys.stdout.write("no code found in that input, paste the redirect URL\n> ")
        sys.stdout.flush()


def has_desktop():
    return sys.platform in ("darwin", "win32") or bool(
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    )


def cmd_login():
    verifier = base64url(secrets.token_bytes(32))
    challenge = base64url(hashlib.sha256(verifier.encode("ascii")).digest())
    # The authorize page accepts the verifier as state, which is what pi sends.
    state = verifier
    try:
        server = CallbackServer(state)
    except OSError as err:
        raise Fail("cannot listen on %s: %s" % (REDIRECT_URI, err))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    query = urllib.parse.urlencode(
        {
            "code": "true",
            "client_id": CLIENT_ID,
            "response_type": "code",
            "redirect_uri": REDIRECT_URI,
            "scope": SCOPES,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "state": state,
        }
    )
    url = AUTHORIZE_URL + "?" + query
    print("Log in to Claude in your browser:\n\n  %s\n" % url)
    if has_desktop():
        webbrowser.open(url)
    print("Waiting for the browser. If it runs on another machine, paste the final redirect URL here.")
    try:
        code, got_state = wait_for_code(server, state)
    finally:
        server.shutdown()
        server.server_close()
    print("Exchanging the code for tokens...", flush=True)
    data = post_json(
        TOKEN_URL,
        {
            "grant_type": "authorization_code",
            "client_id": CLIENT_ID,
            "code": code,
            "state": got_state,
            "redirect_uri": REDIRECT_URI,
            "code_verifier": verifier,
        },
    )
    tokens = tokens_from_response(data)
    save_tokens(tokens)
    print("Logged in as %s. Tokens are in %s." % (tokens.get("email", "your Claude account"), token_path()))
    print("Restart maki if it is running, then pick a model, for example: /model claude/claude-opus-5")


def cmd_logout():
    try:
        os.remove(token_path())
    except FileNotFoundError:
        print("no Claude tokens were stored")
        return
    print("Claude tokens removed")


def cmd_info():
    info = {"display_name": DISPLAY_NAME, "base": "anthropic", "has_auth": True, "system_prefix": IDENTITY}
    sys.stdout.write(json.dumps(info) + "\n")


def cmd_resolve():
    tokens = require_tokens()
    if expires_within(tokens, REFRESH_MARGIN_S):
        tokens = refresh_tokens(tokens)
    emit_auth(tokens)


def cmd_reload():
    emit_auth(require_tokens())


def cmd_refresh():
    emit_auth(refresh_tokens(require_tokens()))


def cmd_status():
    tokens = load_tokens()
    status = {
        "logged_in": tokens is not None,
        "email": (tokens or {}).get("email"),
        "expires_in_s": (tokens["expires"] - now_ms()) // 1000 if tokens else None,
    }
    sys.stdout.write(json.dumps(status) + "\n")


COMMANDS = {
    "info": cmd_info,
    "resolve": cmd_resolve,
    "reload": cmd_reload,
    "refresh": cmd_refresh,
    "login": cmd_login,
    "logout": cmd_logout,
    "status": cmd_status,
}


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        sys.stderr.write("usage: claude <%s>\n" % "|".join(COMMANDS))
        return 2
    try:
        COMMANDS[argv[1]]()
    except Fail as err:
        sys.stderr.write("%s\n" % err)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
