CALLBACK_HOST = "127.0.0.1"
CALLBACK_PORT = 53692
CALLBACK_PATH = "/callback"
CONSOLE_REDIRECT_URI = "https://console.anthropic.com/oauth/code/callback"
UPSTREAM = os.environ.get("MAKI_CLAUDE_UPSTREAM", "https://api.anthropic.com")
# maki polls subscription usage only for base URLs that mention the Anthropic
# host, so the proxy base URL carries it as a path segment and strips it again.
UPSTREAM_MARKER = "/api.anthropic.com"
MESSAGES_PATH = "/v1/messages"
HEALTH_PATH = "/healthz"
OAUTH_BETAS = ("claude-code-20250219", "oauth-2025-04-20")
CLAUDE_CLI_VERSION = "2.1.251"
USER_AGENT = "claude-cli/%s (external, cli)" % CLAUDE_CLI_VERSION
