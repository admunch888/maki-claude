#!/usr/bin/env python3
"""maki dynamic provider for a Claude subscription (Pro or Max) over OAuth.

maki calls `info`, `resolve`, `reload`, `refresh`, `login` and `logout`. The
maki-claude plugin installs this file into the config `providers/` directory,
keeps `serve` running as a job for the lifetime of the maki process, and calls
`status` for the /claude command.

`serve` is a loopback HTTP proxy in front of api.anthropic.com. The subscription
token is only accepted for requests that look like Claude Code, so the proxy
adds the OAuth beta headers and Claude Code client headers, and renames tools
the way pi-claude does: Claude Code core tools get their canonical casing and
every other flat tool becomes `mcp__maki__<name>` on the wire, then tool calls
coming back are renamed to what maki registered.
"""

import base64
import hashlib
import http.client
import http.server
import json
import os
import secrets
import select
import socket
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

SLUG = "claude"
